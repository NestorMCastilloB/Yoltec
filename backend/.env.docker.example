APP_NAME=Yoltec
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Base de datos — PostgreSQL (Neon o local) ───────────────────
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

# ─── Sesión / caché / colas ──────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ─── Email ───────────────────────────────────────────────────────
# Desarrollo: MAIL_MAILER=log o SMTP local con Mailpit.
# Producción:  MAIL_MAILER=resend + RESEND_API_KEY.
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yoltec.test
MAIL_FROM_NAME="Yoltec"

# Requeridas solo con MAIL_MAILER=resend
RESEND_API_KEY=
RESEND_VERIFIED_EMAIL=

# ─── Modo demostración ───────────────────────────────────────────
# Resend en plan gratuito solo entrega al correo verificado de la cuenta, así que
# un visitante nunca recibe el código de 2FA y no puede pasar de esa pantalla.
# Con DEMO_MODE=true, las cuentas de DEMO_USUARIOS reciben el código en la
# respuesta del login en vez de por correo. El segundo factor NO se desactiva:
# el código sigue caducando a los 10 minutos y sigue siendo de un solo uso.
# Sin DEMO_USUARIOS no afecta a nadie, aunque DEMO_MODE esté en true.
DEMO_MODE=false
DEMO_USUARIOS=

# ─── Servicios internos ──────────────────────────────────────────
IA_SERVICE_URL=http://ia:5000
FRONTEND_URL=http://localhost:4200

# ─── Firebase Cloud Messaging (push al móvil) ────────────────────
# Ruta al JSON de service account, relativa a backend/
FIREBASE_CREDENTIALS=storage/app/firebase-adminsdk.json
FIREBASE_PROJECT_ID=yoltec
